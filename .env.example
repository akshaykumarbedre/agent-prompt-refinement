# OpenAI API Key for GPT-4 Judge
OPENAI_API_KEY=your-openai-api-key-here

# Agent API Configuration
AGENT_API_URL=http://localhost:8000/api/agent/invoke
AGENT_API_KEY=your-agent-api-key

# Prompt Management API Configuration
PROMPT_API_GET_URL=http://localhost:8000/api/prompt/get
PROMPT_API_UPDATE_URL=http://localhost:8000/api/prompt/update
PROMPT_API_KEY=your-prompt-api-key

# Workflow Settings
MAX_ITERATIONS=10
CONVERGENCE_THRESHOLD=0.95
IMPROVEMENT_MIN=0.02
PATIENCE=3
PASS_SCORE_THRESHOLD=7
